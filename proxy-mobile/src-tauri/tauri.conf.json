{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rama Proxy",
  "version": "1.4.1",
  "identifier": "com.zqliang.ramaproxy",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rama Proxy",
        "width": 420,
        "height": 820,
        "minWidth": 320,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1401,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
